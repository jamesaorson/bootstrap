#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

. ../functions.sh

case "$(bootstrap_platform)" in
    linux)
		bootstrap_install guile-3.0
        ;;
    omarchy|darwin)
		bootstrap_install guile
        ;;
    *)
        echo "UNKNOWN:$(bootstrap_platform)"
        exit 1
        ;;
esac

ln -s -f $(pwd)/.guile ${HOME}/.guile


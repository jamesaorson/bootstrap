#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

. ../functions.sh

case "$(bootstrap_platform)" in
    linux)
		bootstrap_install guix
        ;;
    omarchy)
        omarchy pkg aur add guix
        ;;
    darwin)
        echo "UNSUPPORTED"
		exit 1
        ;;
    *)
        echo "UNKNOWN:$(bootstrap_platform)"
        exit 1
        ;;
esac


#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

. ../functions.sh

case "$(bootstrap_platform)" in
    omarchy)
        bootstrap_install opam
        ;;
    *)
        export PATH="${HOME}/.local/brew/bin:${PATH}"

        if ! command -v brew; then
            echo "Setting up brew"
            ../brew/setup
            echo "brew set up"
        fi

        brew install --HEAD opam
        ;;
esac

opam --version


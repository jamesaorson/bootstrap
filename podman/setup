#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

. ../functions.sh

case "$(bootstrap_platform)" in
    linux)
        if sudo -v; then
            bootstrap_install \
                buildah \
                containerd \
                fuse-overlayfs \
                slirp4netns \
                uidmap
        fi
        ;;
    omarchy)
        bootstrap_install \
            buildah \
            fuse-overlayfs \
            slirp4netns
        ;;
    darwin)
        ;;
    *)
        echo "UNKNOWN:$(bootstrap_platform)"
        exit 1
        ;;
esac

bootstrap_install podman

podman --version


#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

. ../functions.sh

bootstrap_install bat
BAT=bat

case "$(bootstrap_platform)" in
    linux)
        BAT=batcat
        batcat --version
        ;;
    omarchy|darwin)
        bat --version
        ;;
    *)
        echo "UNKNOWN:$(bootstrap_platform)"
        exit 1
        ;;
esac

mkdir -p ${HOME}/.config/bat/
ln -s -f $(pwd)/config ${HOME}/.config/bat/config

if ! [[ -d ${HOME}/.config/bat/themes ]]; then
    BRANCH=main bootstrap_clone 'https://github.com/catppuccin/bat' ${HOME}/.config/bat/themes
fi
${BAT} cache --build


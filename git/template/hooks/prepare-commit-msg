#! /usr/bin/env bash

set -o pipefail

generate_prefix() {
  # Default branches to skip (can be overridden by environment)
  if [ -z "${BRANCHES_TO_SKIP+x}" ]; then
    BRANCHES_TO_SKIP=(main master trunk)
  fi

  set -u

  COMMIT_MSG_FILE="$1"

  # Nothing to do if we can't determine the branch name
  if [ -z "${BRANCH_NAME}" ]; then
    return 0
  fi

  # Extract `type` (first path segment) and the rest after the slash
  TYPE="${BRANCH_NAME%%/*}"
  REST="${BRANCH_NAME#*/}"
  if [ "$REST" = "${BRANCH_NAME}" ]; then
    REST=""
  fi

  # Skip configured branches
  BRANCH_EXCLUDED=0
  for b in "${BRANCHES_TO_SKIP[@]}"; do
    if [ "${BRANCH_NAME}" = "$b" ] || [ "${TYPE}" = "$b" ]; then
      BRANCH_EXCLUDED=1
      break
    fi
  done

  if [ "${BRANCH_EXCLUDED}" -gt 0 ]; then
    return 0
  fi


  # Determine issue number and whether the branch is an "issue-only" branch
  # - For branches like `feat/195-...` we treat `TYPE` as commit type and `ISSUE` as scope
  # - For branches like `195-...` or `195_...` (no slash) we produce `195: ...`
  ISSUE=""
  ISSUE_ONLY=0
  if [ -n "${REST}" ]; then
    if [[ "${REST}" =~ ^([0-9]+) ]]; then
      ISSUE="${BASH_REMATCH[1]}"
    fi
  else
    # No slash in branch; check for leading digits followed by dash/underscore or end
    # Use a bash-compatible regex (capture optional separator) instead of non-capturing group
    if [[ "$TYPE" =~ ^([0-9]+)([-_].*)?$ ]]; then
      ISSUE="${BASH_REMATCH[1]}"
      ISSUE_ONLY=1
    fi
  fi

  # Build the conventional-commit prefix
  if [ "$ISSUE_ONLY" -eq 1 ]; then
    PREFIX="${ISSUE}: "
  else
    # Only generate a type-based prefix when branch has a slash (i.e., TYPE/REST)
    if [ -n "${REST}" ]; then
      if [ -n "$ISSUE" ]; then
        PREFIX="${TYPE}(${ISSUE}): "
      else
        PREFIX="${TYPE}: "
      fi
    else
      # Non-specific single-segment branch (e.g., "asdasd") -> no prefix
      PREFIX=""
    fi
  fi

  # If no prefix to add, return empty
  if [ -z "${PREFIX}" ]; then
    echo ""
    return 0
  fi

  # Don't prepend to a message that already carries a bracketed ticket key, e.g.
  # "[CLOUD-239472] ..." or "[TRIVIAL] ...". Repos on that convention require the
  # bare key to lead the subject, so a conventional-commit type in front of it
  # breaks their PR checks. This fires regardless of branch shape, because branch
  # naming and subject convention are set by different owners -- a `feat/...`
  # branch in a `[CLOUD-...]` repo is normal, not a mistake.
  if grep -qE "^\[[A-Z][A-Z0-9]*(-[0-9]+)?\][[:space:]]" "${COMMIT_MSG_FILE}" 2>/dev/null; then
    echo ""
    return 0
  fi

  # Don't prepend if the commit message already starts with the intended prefix
  if [ "$ISSUE_ONLY" -eq 1 ]; then
    if grep -qE "^[0-9]+: " "${COMMIT_MSG_FILE}" 2>/dev/null; then
      echo ""
      return 0
    fi
  else
    if grep -q "^${TYPE}: " "${COMMIT_MSG_FILE}" 2>/dev/null || grep -qE "^${TYPE}\\([0-9]+\\): " "${COMMIT_MSG_FILE}" 2>/dev/null; then
      echo ""
      return 0
    fi
  fi

  echo "${PREFIX}"
}

run-tests() {
  local test_cases=(
    # format: branch|commit-message|expected-prefix
    "feat/195-add-login|test|feat(195): "
    "chore/195-add-login|test|chore(195): "
    "feat/add-login|test|feat: "
    "asd/195-add-login|test|asd(195): "
    "195-add-login|test|195: "
    "asdasd|test|"
    # already-prefixed messages are left alone
    "feat/add-login|feat: already prefixed|"
    "195-add-login|195: already prefixed|"
    # bracketed ticket keys win over the branch-derived prefix
    "feat/phantom-tokens-cuj-001-spec-001|[CLOUD-239472] Hoist the header name|"
    "feat/195-add-login|[CLOUD-239472] Hoist the header name|"
    "user/jorson/CLOUD-1|[XAAS-42] Do the thing|"
    "195-add-login|[TRIVIAL] Tidy up|"
    # ...but only for uppercase bracketed keys, not any bracketed text
    "feat/add-login|[wip] lowercase is not a ticket key|feat: "
    "feat/add-login|[Mixed-1] not a ticket key either|feat: "
  )

  local failures=0
  for t in "${test_cases[@]}"; do
    IFS='|' read -r branch message expected <<< "$t"
    # Ensure BRANCH_NAME is set for the function under test
    BRANCH_NAME="${branch}"

    # Use a real temporary file (avoid /dev/fd process substitution)
    local temp_msg=$(mktemp) || { echo "mktemp failed"; exit 2; }
    printf "%s\n" "${message}" > "${temp_msg}"

    # Call the function under test with the temp file path
    local prefix="$(generate_prefix "${temp_msg}")"
    # Read result and compare
    if [ "${prefix}" != "${expected}" ]; then
      echo "  FAILED TEST CASE: branch '${branch}', message '${message}': got '${prefix}', expected '${expected}'"
      failures=$((failures + 1))
    fi

    rm -f "${temp_msg}" "${temp_msg}.bak" || true
  done

  if [ "${failures}" -gt 0 ]; then
    echo "${failures} test(s) failed"
    exit 1
  fi
}
run-tests

COMMIT_MSG_FILE="$1"
BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
PREFIX="$(generate_prefix "${COMMIT_MSG_FILE}")"
if [ -n "${PREFIX}" ]; then
  sed -i.bak -e "1s/^/${PREFIX}/" "${COMMIT_MSG_FILE}"
fi

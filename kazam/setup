#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

. ../functions.sh

case "$(bootstrap_platform)" in
    linux)
        bootstrap_install kazam
        kazam --version
        ;;
    omarchy)
        omarchy pkg aur add kazam
        kazam --version
        ;;
    *)
        echo "UNSUPPORTED:$(bootstrap_platform)"
        exit 1
        ;;
esac


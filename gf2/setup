#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

. ../functions.sh

case "$(bootstrap_platform)" in
    linux|omarchy)
        ;;
    darwin)
	echo "Unsupported platform darwin"
	exit 1
        ;;
    *)          echo "UNKNOWN:$(bootstrap_platform)"; exit 1;;
esac

bootstrap_install gdb

SRC_DIR=${HOME}/.local/src
mkdir -p ${SRC_DIR}
BRANCH=master bootstrap_clone https://github.com/nakst/gf ${SRC_DIR}/gf2 
cd ${SRC_DIR}/gf2
./build.sh


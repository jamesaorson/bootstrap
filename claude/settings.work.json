{
  "env": {
    "SHELL": "/opt/homebrew/bin/zsh",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "multi-agent-design-review": "off",
    "pure1build-service": "off",
    "gh-stack": "off",
    "brainstorming": "off",
    "system-design": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jorson/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/bin/no-ai-attribution.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": []
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "optimus-tokenomics-audit@dx-ai": true,
    "hyperscale-build-kb@hyperscale-build": true,
    "autobutler@autobutler-org": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "dx-ai": {
      "source": {
        "source": "github",
        "repo": "pure-pure1/dx-ai-plugin-marketplace-claude"
      }
    },
    "hyperscale-build": {
      "source": {
        "source": "github",
        "repo": "pure-hyperscale/hyperscale-build-agent-knowledge-base"
      }
    },
    "autobutler-org": {
      "source": {
        "source": "github",
        "repo": "autobutler-org/agent-plugins"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "gitAttribution": false
}

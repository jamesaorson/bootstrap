{
  "env": {
    "SHELL": "/opt/homebrew/bin/zsh",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
	"attribution": {
		"commit": false,
		"pr": false,
    "sessionUrl": false
	},
  "permissions": {
    "allow": [
      "Bash(*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "multi-agent-design-review": "off",
    "pure1build-service": "off",
    "gh-stack": "off",
    "brainstorming": "off",
    "system-design": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C ~/.claude/team-standards pull -q 2>/dev/null || git clone -q --depth 1 org-127482596@github.com:pure-experimental/dx-submerce-team-standards.git ~/.claude/team-standards; sh ~/.claude/team-standards/session-start.bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jorson/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "looking-glass hook stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "optimus-claude-audit@dx-ai": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "dx-ai": {
      "source": {
        "source": "github",
        "repo": "pure-pure1/dx-ai-plugin-marketplace-claude"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "gitAttribution": false
}
